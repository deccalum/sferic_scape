# sferic_scape configuration — copy to `.env` and fill in.

# Library / input root scanned for WAVs and per-domain .yml annotations.
SFERIC_WAV_ROOT=data/freesound

# Output root for generated JSON/WAV — grouped under OUT_DIR/<stem>/.
SFERIC_OUT_DIR=data/out

# Directory for sferic_YYYYMMDD_HHMMSS.log files.
SFERIC_LOG_DIR=data/logs

# Synthesis sample rate (Hz).
SFERIC_SAMPLE_RATE=48000

# Persist the ParametricModel JSON (<stem>jsonmodel.json). Off by default.
SFERIC_WRITE_JSON=0
